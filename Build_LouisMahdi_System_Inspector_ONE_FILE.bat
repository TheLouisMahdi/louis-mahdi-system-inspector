@echo off
setlocal EnableExtensions
chcp 65001 >nul
title LouisMahdi System Inspector 2.2.0 - Portable Offline EXE Builder
set "LM_BUILDER_SELF=%~f0"
set "LM_BUILDER_OUT=%~dp0"
echo ===============================================================
echo  LouisMahdi System Inspector 2.2.0 - Portable EXE Builder
echo  Developed by LouisMahdi
echo  github.com/TheLouisMahdi
echo ===============================================================
echo.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:LM_BUILDER_SELF);$m='###__LOUISMAHDI_BUILDER_POWERSHELL__###';$i=$t.LastIndexOf($m);if($i -lt 0){throw 'Embedded builder marker was not found.'};Invoke-Expression($t.Substring($i+$m.Length))"
set "BUILD_EXIT=%ERRORLEVEL%"
echo.
if not "%BUILD_EXIT%"=="0" (echo Build failed with exit code %BUILD_EXIT%.) else (echo Build finished successfully.)
pause
exit /b %BUILD_EXIT%
###__LOUISMAHDI_BUILDER_POWERSHELL__###
$ErrorActionPreference='Stop'
Set-StrictMode -Version 2.0
$tempRoot=$null
function Write-Step([string]$Text){Write-Host "[BUILD] $Text" -ForegroundColor Cyan}
function Write-Success([string]$Text){Write-Host "[ OK  ] $Text" -ForegroundColor Green}
function Write-Failure([string]$Text){Write-Host "[FAIL ] $Text" -ForegroundColor Red}
function Write-EmbeddedFile([string]$Base64,[string]$Path){[IO.File]::WriteAllBytes($Path,[Convert]::FromBase64String($Base64))}
try{
    if($env:OS -ne 'Windows_NT'){throw 'This builder must run on Windows.'}
    $outputDirectory=$env:LM_BUILDER_OUT
    if([string]::IsNullOrWhiteSpace($outputDirectory)){$outputDirectory=(Get-Location).Path}
    $outputExe=Join-Path $outputDirectory 'LouisMahdi_System_Inspector.exe'
    $outputHash=Join-Path $outputDirectory 'LouisMahdi_System_Inspector.exe.sha256.txt'
    $tempRoot=Join-Path ([IO.Path]::GetTempPath()) ('LouisMahdi_Build_'+[guid]::NewGuid().ToString('N'))
    $srcDir=Join-Path $tempRoot 'src'
    $testDir=Join-Path $tempRoot 'tests'
    $docsDir=Join-Path $tempRoot 'docs'
    $assetsDir=Join-Path $tempRoot 'assets'
    New-Item -ItemType Directory -Path $srcDir,$testDir,$docsDir,$assetsDir -Force|Out-Null
    $sourcePath=Join-Path $srcDir 'LouisMahdi.SystemInspector.ps1'
    $testPath=Join-Path $testDir 'Run-MockTests.ps1'
    $validateSourcePath=Join-Path $testDir 'Validate-Source.ps1'
    $validateLauncherPath=Join-Path $testDir 'Validate-Launcher.ps1'
    $hostTemplatePath=Join-Path $docsDir 'LouisMahdiHost.cs'
    $hostPath=Join-Path $tempRoot 'LouisMahdiHost.Generated.cs'
    $iconPath=Join-Path $assetsDir 'LouisMahdi_System_Inspector.ico'
    $projectRoot=$outputDirectory
    $projectSource=Join-Path $projectRoot 'src\LouisMahdi.SystemInspector.ps1'
    $projectTests=Join-Path $projectRoot 'tests\Run-MockTests.ps1'
    $projectValidateSource=Join-Path $projectRoot 'tests\Validate-Source.ps1'
    $projectValidateLauncher=Join-Path $projectRoot 'tests\Validate-Launcher.ps1'
    $projectHost=Join-Path $projectRoot 'docs\LouisMahdiHost.cs'
    $projectIcon=Join-Path $projectRoot 'assets\LouisMahdi_System_Inspector.ico'
    $projectFiles=@($projectSource,$projectTests,$projectValidateSource,$projectValidateLauncher,$projectHost,$projectIcon)
    $useProjectFiles=(@($projectFiles|Where-Object{-not (Test-Path -LiteralPath $_ -PathType Leaf)}).Count -eq 0)
    Write-Step 'Preparing source, tests, launcher, and icon...'
    if($useProjectFiles){
        Copy-Item -LiteralPath $projectSource -Destination $sourcePath -Force
        Copy-Item -LiteralPath $projectTests -Destination $testPath -Force
        Copy-Item -LiteralPath $projectValidateSource -Destination $validateSourcePath -Force
        Copy-Item -LiteralPath $projectValidateLauncher -Destination $validateLauncherPath -Force
        Copy-Item -LiteralPath $projectHost -Destination $hostTemplatePath -Force
        Copy-Item -LiteralPath $projectIcon -Destination $iconPath -Force
        Write-Success 'Project files loaded directly.'
    }else{
        Write-EmbeddedFile '' $sourcePath
        Write-EmbeddedFile '' $testPath
        Write-EmbeddedFile '' $validateSourcePath
        Write-EmbeddedFile '' $validateLauncherPath
        Write-EmbeddedFile '' $hostTemplatePath
        Write-EmbeddedFile '' $iconPath
        Write-Success 'Embedded standalone files extracted.'
    }
    Write-Step 'Validating PowerShell syntax and source contracts...'
    & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $validateSourcePath -SourcePath $sourcePath
    if($LASTEXITCODE -ne 0){throw 'PowerShell source validation failed.'}
    Write-Step 'Validating portable launcher contracts...'
    & powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $validateLauncherPath -LauncherPath $hostTemplatePath
    if($LASTEXITCODE -ne 0){throw 'Portable launcher validation failed.'}
    Write-Step 'Running offline mock tests...'
    $testOutput=& powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File $testPath 2>&1
    $testOutput|ForEach-Object{Write-Host $_}
    if($LASTEXITCODE -ne 0){throw 'Offline mock tests failed.'}
    Write-Success 'Source validation and offline mock tests passed.'
    Write-Step 'Generating the managed-resource launcher...'
    $sourceHash=(Get-FileHash -LiteralPath $sourcePath -Algorithm SHA256).Hash.ToLowerInvariant()
    $hostTemplate=[IO.File]::ReadAllText($hostTemplatePath,[Text.Encoding]::UTF8)
    if($hostTemplate -notmatch '__SOURCE_SHA256__'){throw 'Launcher source-hash placeholder was not found.'}
    $hostSource=$hostTemplate.Replace('__SOURCE_SHA256__',$sourceHash)
    [IO.File]::WriteAllText($hostPath,$hostSource,(New-Object Text.UTF8Encoding($false)))
    if($hostSource -match 'FromBase64String|ToBase64String'){throw 'The generated runtime launcher contains a forbidden Base64 dependency.'}
    if($hostSource -match 'System\.Management\.Automation'){throw 'The generated runtime launcher contains an in-process PowerShell dependency.'}
    if($hostSource -notmatch 'GetManifestResourceStream' -or $hostSource -notmatch 'ProcessStartInfo' -or $hostSource -notmatch 'launcher-self-test'){throw 'The generated portable launcher contract is incomplete.'}
    Write-Success 'Managed-resource launcher generated without runtime Base64 decoding.'
    Write-Step 'Locating the built-in .NET Framework compiler...'
    $compilerCandidates=@(
        (Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'),
        (Join-Path $env:WINDIR 'Microsoft.NET\Framework\v4.0.30319\csc.exe')
    )
    $compiler=$compilerCandidates|Where-Object{Test-Path -LiteralPath $_ -PathType Leaf}|Select-Object -First 1
    if(-not $compiler){throw '.NET Framework 4.x C# compiler was not found.'}
    if(Test-Path -LiteralPath $outputExe){Remove-Item -LiteralPath $outputExe -Force}
    if(Test-Path -LiteralPath $outputHash){Remove-Item -LiteralPath $outputHash -Force}
    $compilerArguments=@(
        '/nologo',
        '/target:winexe',
        '/optimize+',
        '/platform:anycpu',
        ('/win32icon:"'+$iconPath+'"'),
        ('/out:"'+$outputExe+'"'),
        '/reference:System.dll',
        '/reference:System.Core.dll',
        ('/resource:"'+$sourcePath+'",LouisMahdi.SystemInspector.Source'),
        ('/resource:"'+$iconPath+'",LouisMahdi.SystemInspector.Icon'),
        ('"'+$hostPath+'"')
    )
    Write-Step 'Compiling the single-file AnyCPU application...'
    $compilerOutput=& $compiler $compilerArguments 2>&1
    if($LASTEXITCODE -ne 0 -or -not (Test-Path -LiteralPath $outputExe)){throw "C# compilation failed:`r`n$($compilerOutput -join [Environment]::NewLine)"}
    Write-Step 'Running the compiled launcher self-test...'
    $selfTest=Start-Process -FilePath $outputExe -ArgumentList '--launcher-self-test' -Wait -PassThru
    if($selfTest.ExitCode -ne 0){Remove-Item -LiteralPath $outputExe -Force -ErrorAction SilentlyContinue;throw "Compiled launcher self-test failed with exit code $($selfTest.ExitCode)."}
    $exeBytes=[IO.File]::ReadAllBytes($outputExe)
    $exeText=[Text.Encoding]::ASCII.GetString($exeBytes)
    if($exeText -match 'FromBase64String'){Remove-Item -LiteralPath $outputExe -Force -ErrorAction SilentlyContinue;throw 'The generated EXE unexpectedly contains runtime Base64 decoding.'}
    $exeHash=(Get-FileHash -LiteralPath $outputExe -Algorithm SHA256).Hash.ToLowerInvariant()
    [IO.File]::WriteAllText($outputHash,("{0}  LouisMahdi_System_Inspector.exe`r`n" -f $exeHash),(New-Object Text.UTF8Encoding($false)))
    $fileInfo=Get-Item -LiteralPath $outputExe
    Write-Success 'AnyCPU launcher resource and PowerShell discovery self-test passed.'
    Write-Success ("Build completed: {0}" -f $outputExe)
    Write-Host ("File size: {0:N0} bytes" -f $fileInfo.Length) -ForegroundColor Yellow
    Write-Host ("SHA-256: {0}" -f $exeHash) -ForegroundColor Yellow
    Write-Host ''
    Write-Host 'The EXE contains the PowerShell application as a verified managed resource.' -ForegroundColor White
    Write-Host 'No Base64 application payload is decoded by the distributed EXE.' -ForegroundColor White
    Write-Host 'Target: Windows 10/11 and Windows Server 2016 or later with Windows PowerShell 5.1.' -ForegroundColor White
    Write-Host 'Architecture: AnyCPU launcher with native Windows PowerShell discovery.' -ForegroundColor White
    Write-Host 'Developed by LouisMahdi | github.com/TheLouisMahdi' -ForegroundColor Green
    Start-Process explorer.exe -ArgumentList ('/select,"'+$outputExe+'"') -ErrorAction SilentlyContinue
    exit 0
}catch{
    Write-Failure $_.Exception.Message
    Write-Host ''
    Write-Host 'No application EXE was distributed because validation, compilation, or self-test failed.' -ForegroundColor Yellow
    exit 1
}finally{
    if($tempRoot -and (Test-Path -LiteralPath $tempRoot)){Remove-Item -LiteralPath $tempRoot -Recurse -Force -ErrorAction SilentlyContinue}
}
